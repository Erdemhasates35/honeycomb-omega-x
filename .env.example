# Honeycomb Omega X — Environment Template
# Copy to .env.local for local development.
# For production: set these in Vercel → Project → Settings → Environment Variables
# NEVER commit real values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: only for privileged server-side jobs (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Future execution-core connection (server-side only)
# EXECUTION_CORE_URL=
# GUARD_SERVICE_URL=
