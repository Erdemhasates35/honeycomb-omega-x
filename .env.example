# Honeycomb Omega X — Environment Template
# Copy to .env.local for local development.
# For production: set these in Vercel → Project → Settings → Environment Variables
# NEVER commit real values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required for durable Guard audit writes after user authentication.
# NEVER prefix this with NEXT_PUBLIC_ and NEVER expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Future execution-core connection (server-side only)
# EXECUTION_CORE_URL=
# GUARD_SERVICE_URL=
